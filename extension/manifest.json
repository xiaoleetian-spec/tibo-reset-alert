{
  "manifest_version": 3,
  "name": "Tibo RESET 提醒",
  "description": "监控 Tibo 发布的 Codex RESET 消息，并按重要程度及时提醒。",
  "version": "0.3.9",
  "version_name": "0.3.9 公开发行版",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Tibo RESET 提醒", "default_popup": "panel.html" },
  "icons": { "128": "icon.png" },
  "content_scripts": [{
    "matches": ["https://x.com/thsottiaux", "https://x.com/thsottiaux/*"],
    "js": ["parser.js", "content.js"],
    "run_at": "document_idle"
  }]
}
